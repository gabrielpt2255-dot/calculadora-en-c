#include <stdio.h>

/*
 * Calculadora basica en C
 * Usa: menu con do-while, sentencia switch y validacion de division entre cero.
 */

int main() {
    int opcion;
    double num1, num2, resultado;

    do {
        printf("\n===== CALCULADORA =====\n");
        printf("1. Sumar\n");
        printf("2. Restar\n");
        printf("3. Multiplicar\n");
        printf("4. Dividir\n");
        printf("5. Salir\n");
        printf("Elige una opcion: ");

        if (scanf("%d", &opcion) != 1) {
            printf("Entrada no valida. Intenta de nuevo.\n");
            while (getchar() != '\n');  /* limpia el buffer */
            opcion = 0;
            continue;
        }

        if (opcion >= 1 && opcion <= 4) {
            printf("Ingresa el primer numero: ");
            scanf("%lf", &num1);
            printf("Ingresa el segundo numero: ");
            scanf("%lf", &num2);
        }

        switch (opcion) {
            case 1:
                resultado = num1 + num2;
                printf("Resultado: %.2f + %.2f = %.2f\n", num1, num2, resultado);
                break;
            case 2:
                resultado = num1 - num2;
                printf("Resultado: %.2f - %.2f = %.2f\n", num1, num2, resultado);
                break;
            case 3:
                resultado = num1 * num2;
                printf("Resultado: %.2f * %.2f = %.2f\n", num1, num2, resultado);
                break;
            case 4:
                if (num2 == 0) {
                    printf("Error: no se puede dividir entre cero.\n");
                } else {
                    resultado = num1 / num2;
                    printf("Resultado: %.2f / %.2f = %.2f\n", num1, num2, resultado);
                }
                break;
            case 5:
                printf("Hasta luego!\n");
                break;
            default:
                printf("Opcion no valida. Elige un numero del 1 al 5.\n");
        }
    } while (opcion != 5);

    return 0;
}
